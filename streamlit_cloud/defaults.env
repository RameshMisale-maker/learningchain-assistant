# Non-secret settings for the Streamlit Cloud demo (copied from the production .env; no keys).
# Secrets such as OPENAI_API_KEY go in Streamlit Cloud -> App settings -> Secrets.
ALLOW_ANONYMOUS_PUBLIC=true
ANTHROPIC_MODEL=claude-sonnet-4-5
APP_ENV=demo
BLOCK_PROMPT_INJECTION=true
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_PRICE_PER_1M=0
GOLDEN_ASSIST_THRESHOLD=0.50
GOLDEN_DIRECT_THRESHOLD=0.78
GROUNDING_MIN_SUPPORT=0.6
GROUNDING_MODE=lexical
HYBRID_VECTOR_WEIGHT=0.5
INGEST_WORKER_ENABLED=false
LLM_FALLBACK_PROVIDER=openai
LLM_PRICE_INPUT_PER_1M=3.00
LLM_PRICE_OUTPUT_PER_1M=15.00
LLM_PROVIDER=anthropic
LLM_TEMPERATURE=0
LOG_LEVEL=WARNING
MAX_QUERY_CHARS=1000
MIN_QUERY_COVERAGE=0.40
MIN_QUERY_COVERAGE_LLM=0.25
MIN_RERANK_SCORE=0.15
OCR_ENABLED=false
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_FALLBACK_MODELS=openai/gpt-oss-20b
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_PRICE_INPUT_PER_1M=0
OPENAI_PRICE_OUTPUT_PER_1M=0
OPENAI_REASONING_EFFORT=low
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ROUTER_MODE=hybrid
TOKENIZERS_PARALLELISM=false
TOP_K_BM25=20
TOP_K_RERANK=5
TOP_K_VECTOR=20
VECTOR_BACKEND=chroma
WEB_MONITOR_ENABLED=false
