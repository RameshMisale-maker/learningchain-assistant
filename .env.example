# =====================================================================
# Sapphirus AI Assistant - environment configuration
# Copy to .env and fill in values. NEVER commit .env to source control.
# Secrets (API keys, tokens, passwords) belong only here or in your secret store - never in frontend code.
# =====================================================================
APP_ENV=production                  # development | production
LOG_LEVEL=INFO

# ---- LLM: Anthropic Claude (answer generation) ----
LLM_PROVIDER=anthropic              # anthropic | openai | extractive (no LLM - quotes sources only)
ANTHROPIC_API_KEY=                  # REQUIRED for generated answers. Backend only.
ANTHROPIC_MODEL=claude-sonnet-4-5   # NOTE: claude-sonnet-4-5 is deprecated and retires on 2026-11-30 (Claude API).
                                    #       Plan the switch to the current Sonnet (claude-sonnet-5-5) and re-run the evaluation.
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Pricing for cost tracking - USD per 1M tokens. Set to the provider's CURRENT published price for your model.
LLM_PRICE_INPUT_PER_1M=3.00
LLM_PRICE_OUTPUT_PER_1M=15.00
EMBEDDING_PRICE_PER_1M=0            # 0 for local models; 0.02 for text-embedding-3-small
RERANK_PRICE_PER_1K=0               # 0 for the local cross-encoder
# Optional alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=              # comma-separated models tried when OPENAI_MODEL is rate-limited, e.g. openai/gpt-oss-20b on Groq

# ---- Fixed replies ----
# INSUFFICIENT_INFO_TEXT=I couldn't find sufficient verified information in the Sapphirus knowledge base to answer this question accurately. Please contact the appropriate Sapphirus team.
# OUT_OF_SCOPE_TEXT=I'm sorry, I can only answer questions about Sapphirus - LearningChain.

# ---- Embeddings / vector store / reranker (chosen by benchmark - see reports/benchmarks) ----
EMBEDDING_BACKEND=sentence_transformers   # openai | sentence_transformers | local_hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=                  # OpenAI key for EMBEDDING_BACKEND=openai (separate from the Groq OPENAI_API_KEY)
EMBEDDING_BASE_URL=                 # empty = https://api.openai.com/v1
VECTOR_BACKEND=chroma               # chroma | numpy
RERANKER_BACKEND=cross_encoder      # cross_encoder | lexical | none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Changing EMBEDDING_MODEL requires a full re-index: python -m ingestion.cli reindex

# ---- Retrieval & answer tuning ----
TOP_K_VECTOR=40
TOP_K_BM25=40
TOP_K_RERANK=5
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_FUSION=relative
MIN_RERANK_SCORE=0.15
MIN_QUERY_COVERAGE=0.40
MIN_QUERY_COVERAGE_LLM=0.25
MAX_CONTEXT_CHARS=9000
GOLDEN_DIRECT_THRESHOLD=0.78
GOLDEN_ASSIST_THRESHOLD=0.50
ROUTER_MODE=hybrid                  # hybrid | rules | llm
GROUNDING_MODE=lexical              # lexical | llm | off
GROUNDING_MIN_SUPPORT=0.6
# Conversational layer: greetings / typos / incomplete / gibberish / follow-ups handled before retrieval
CONVERSATION_LAYER=true
CONVERSATION_LLM_INTENT=true        # LLM only for short messages the rules cannot classify

# ---- Storage ----
DATA_DIR=data
# PostgreSQL in production (docker-compose sets this); SQLite file in DATA_DIR when empty
DATABASE_URL=
POSTGRES_PASSWORD=                  # used by docker-compose

# ---- Automated ingestion ----
INGEST_WORKER_ENABLED=true          # background worker thread inside the API process (single vector-store writer)
INGEST_POLL_SECONDS=2
INGEST_MAX_ATTEMPTS=3
INGEST_RETRY_BASE_SECONDS=30        # exponential backoff: 30s, 60s, 120s ...
WEB_MONITOR_ENABLED=true
WEB_MONITOR_INTERVAL_MINUTES=360    # default check interval for new monitored sources
WEB_ALLOWED_DOMAINS=sapphirus.in,learningchain.in,learningchainai.zendesk.com   # SSRF allow-list
WEB_FETCH_TIMEOUT_SECONDS=20
WEB_MAX_PAGE_MB=5
# Web scraping for monitored websites: firecrawl (Firecrawl API, renders JavaScript pages) | builtin (direct HTTP)
WEB_SCRAPER=firecrawl
FIRECRAWL_API_KEY=                  # from https://www.firecrawl.dev - without it the builtin scraper is used
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
FIRECRAWL_TIMEOUT_SECONDS=60
FIRECRAWL_MAX_AGE_MS=0              # 0 = always scrape fresh (needed to detect page changes)
WEBHOOK_SECRET=                     # HMAC secret for /api/v1/webhooks/content-updated (CMS / Zendesk). Empty = disabled
ADMIN_NOTIFY_WEBHOOK_URL=           # optional Teams/Slack incoming-webhook URL for ingestion results

# ---- Security ----
AUTH_MODE=token                     # token | proxy_headers | disabled (dev only - refused in production)
TOKEN_HASH_SECRET=                  # long random string - REQUIRED in production
ALLOW_ANONYMOUS_PUBLIC=true         # website visitors get the 'public' role without a token
# Generate tokens with: python -c "import secrets;print(secrets.token_urlsafe(32))"
BOOTSTRAP_ADMIN_TOKEN=
BOOTSTRAP_EMPLOYEE_TOKEN=
BOOTSTRAP_HR_TOKEN=
BOOTSTRAP_PUBLIC_TOKEN=
PROXY_SHARED_SECRET=                # required when AUTH_MODE=proxy_headers
PROXY_USER_HEADER=X-Portal-User
PROXY_ROLES_HEADER=X-Portal-Roles
DEV_ROLES=employee
CORS_ORIGINS=https://chat.sapphirus.in
WIDGET_ALLOWED_ORIGINS=https://sapphirus.in,https://www.sapphirus.in,https://learningchain.in,https://www.learningchain.in
MAX_UPLOAD_MB=25
MAX_QUERY_CHARS=1000
RATE_LIMIT_PER_MINUTE=30
BLOCK_PROMPT_INJECTION=true
CHAT_RETENTION_DAYS=90

# ---- OCR for scanned PDFs (requires Tesseract installed) ----
OCR_ENABLED=false
OCR_LANGUAGE=eng

# ---- Open WebUI (internal staff UI) ----
API_BASE_URL=http://localhost:8000
OPEN_WEBUI_API_KEY=                 # API token: python -m backend.security.manage_users create --username openwebui --roles public
OPEN_WEBUI_PORT=3000
LOG_FORMAT=text                     # text | json (structured logs for log shippers)

# ---- Product configuration (Phase 1) - config/products/<product_id>.yaml ----
# Off: every request uses the default product (one combined assistant, as before). On: the product is resolved per
# request from the `product` field / widget data-product, the legacy `assistant` alias, the request domain or the API key.
PRODUCT_CONFIG_ENABLED=false
PRODUCT_CONFIG_DIR=config/products
DEFAULT_PRODUCT=                   # empty = the product that searches the most knowledge bases
PRODUCT_ID=                        # Streamlit demo only: which product it shows (empty = default)
VECTOR_COLLECTION_PREFIX=sapphirus_
CRAWLER_USER_AGENT=SapphirusAssistantCrawler/1.0 (+knowledge-base indexer)
WEBHOOK_SIGNATURE_HEADER=x-sapphirus-signature
LOG_FILE_NAME=sapphirus_assistant.log
# Fixed replies come from the product config; INSUFFICIENT_INFO_TEXT / OUT_OF_SCOPE_TEXT (above) override them.

# ---- Index versioning (Phase 2) - backend/indexing/versions.py ----
# true: a rebuild fills a NEW collection, is scored by the retrieval eval gate and only then becomes live;
# the previous version stays for an instant rollback (CLI: build-version / list-versions / promote / rollback).
INDEX_VERSIONING_ENABLED=false
EVAL_TOLERANCE=0.02          # promote if new score >= live score - tolerance
KEEP_INDEX_VERSIONS=5
EVAL_GATE_MAX_CASES=40
EVALS_DIR=evals              # optional evals/<product_id>.jsonl: {"question", "kb", "expected": [...]}

# ---- Provider failover (Phase 5) - backend/generation/failover.py ----
LLM_FAILOVER_ENABLED=false
LLM_FAILOVER_TIMEOUT_SECONDS=15
BREAKER_FAILURES=5           # failures within BREAKER_WINDOW_SECONDS open a provider's circuit breaker
BREAKER_WINDOW_SECONDS=60
BREAKER_COOLDOWN_SECONDS=120
# Optional second provider: any OpenAI-compatible endpoint (e.g. a free-tier Gemini or OpenRouter key).
# Example (Gemini): LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=

# ---- Response cache (Phase 4) - database table, no Redis ----
RESPONSE_CACHE_ENABLED=false
CACHE_TTL_HOURS=24
CACHE_MIN_CONFIDENCE=0.5     # answers below this are never cached (semantic threshold: product semantic_cache_threshold)

# ---- Review queue, approved answers, eval cases (Phase 6) ----
REVIEW_QUEUE_ENABLED=false
REVIEW_LOW_CONFIDENCE=0.35   # answers below this confidence are queued for review

# ---- Document freshness tracking (Phase 3) ----
DOC_TRACKING_ENABLED=false
TOMBSTONE_AFTER_MISSES=2     # a crawled page missing this many times in a row is removed
CRAWL_INTERVAL_MINUTES=1440  # product sitemaps (config/products/*.yaml sources.sitemaps) are crawled daily

# ---- Observability (Phase 7) - Prometheus /metrics, alerts (config/alerts.yaml), nightly retrieval eval ----
METRICS_ENABLED=false
METRICS_TOKEN=               # optional bearer token required by /metrics
ALERTS_ENABLED=false
ALERT_CHECK_MINUTES=5
NIGHTLY_EVAL_ENABLED=false
NIGHTLY_EVAL_HOUR=2          # UTC
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=assistant-alerts@localhost
SMTP_STARTTLS=true
# Langfuse tracing: intentionally not enabled (paid / extra service) - request logs + /metrics cover tracing needs.
